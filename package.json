{
  "name": "geometry-kids",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && npm run questions:validate && vite build && node scripts/checkClientBundle.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "questions:generate": "node --use-env-proxy --import tsx scripts/generateQuestions.ts",
    "questions:validate": "tsx scripts/validateQuestions.ts",
    "build:offline": "npm run build && node scripts/buildOffline.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
